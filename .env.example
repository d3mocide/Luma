# Sovereign Health — Environment Variables
# Copy to .env and fill in real values before running.

# Database
PG_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql+asyncpg://sh:${PG_PASSWORD}@postgres:5432/sovereign_health

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=changeme_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# HAE Webhook
HAE_SHARED_SECRET=changeme_generate_with_openssl_rand_hex_32

# LLM
ANTHROPIC_API_KEY=sk-ant-...
LITELLM_BASE_URL=http://litellm:4000

# Whisper
WHISPER_URL=http://whisper:9000

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,https://health.yourdomain.com
