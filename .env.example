# Luma — Environment Variables
# Copy to .env and fill in real values before running.

# Database
PG_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql+asyncpg://sh:${PG_PASSWORD}@postgres:5432/luma

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=changeme_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# HAE Webhook
HAE_SHARED_SECRET=changeme_generate_with_openssl_rand_hex_32

# LLM Cloud Keys (required for meal planning, coaching, narration)
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=

# Local AI (Ollama / LocalAI / Llama.cpp) — only needed if using local/* model routes.
# For a server without Ollama, leave LOCAL_AI_API_BASE blank and use cloud routes below.
# For local dev with Ollama on the host: http://host.docker.internal:11434
LOCAL_AI_API_BASE=
LOCAL_AI_API_KEY=

# LLM Model Routing — LiteLLM library (no separate proxy container needed).
# Patterns:
#   local/<model-id>     → OpenAI-compatible request to LOCAL_AI_API_BASE (Ollama etc.)
#   gemini/<model-id>    → Google Gemini via GEMINI_API_KEY
#   anthropic/<model-id> → Anthropic API via ANTHROPIC_API_KEY
#
# Server (no local GPU): route everything to cloud
FOOD_EXTRACTOR_MODEL=gemini/gemini-2.5-flash
VISION_CLASSIFIER_MODEL=gemini/gemini-2.5-flash
MEAL_PLANNER_MODEL=anthropic/claude-sonnet-4-5
COACH_MODEL=gemini/gemini-2.5-flash
INSIGHT_NARRATOR_MODEL=anthropic/claude-sonnet-4-5
#
# Local dev with Ollama: uncomment and set LOCAL_AI_API_BASE above
# FOOD_EXTRACTOR_MODEL=local/gemma-4-e4b-it
# VISION_CLASSIFIER_MODEL=local/gemma-4-e4b-it

# Whisper
WHISPER_URL=http://whisper:9000

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,https://health.yourdomain.com
VITE_USE_MOCK_DATA=1
