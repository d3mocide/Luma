# Luma — Environment Variables
# Copy to .env and fill in real values before running.

# Database
PG_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql+asyncpg://sh:${PG_PASSWORD}@postgres:5432/luma

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=changeme_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# HAE Webhook
HAE_SHARED_SECRET=changeme_generate_with_openssl_rand_hex_32

# LLM Cloud Keys (required for meal planning, coaching, narration)
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=

# Local AI (Ollama / LocalAI / Llama.cpp) — only needed if using local/* model routes.
# For a server without Ollama, leave LOCAL_AI_API_BASE blank and use cloud routes below.
# For local dev with Ollama on the host: http://host.docker.internal:11434
LOCAL_AI_API_BASE=
LOCAL_AI_API_KEY=

# LLM Model Routing — LiteLLM library (no separate proxy container needed).
# Each role is routed independently — mix local and cloud freely.
# Prefix rules:
#   local/<model-id>     → OpenAI-compatible request to LOCAL_AI_API_BASE (Ollama etc.)
#   gemini/<model-id>    → Google Gemini via GEMINI_API_KEY
#   anthropic/<model-id> → Anthropic API via ANTHROPIC_API_KEY
#
# Primary models
FOOD_EXTRACTOR_MODEL=gemini/gemini-2.5-flash
VISION_CLASSIFIER_MODEL=gemini/gemini-2.5-flash
MEAL_PLANNER_MODEL=anthropic/claude-sonnet-4-5
COACH_MODEL=gemini/gemini-2.5-flash
INSIGHT_NARRATOR_MODEL=anthropic/claude-sonnet-4-5
#
# Optional fallbacks — if the primary call fails, LiteLLM retries with this model.
# Useful when running a local primary (Ollama) that may be unavailable.
# Leave blank to disable fallback for that role.
FOOD_EXTRACTOR_FALLBACK_MODEL=
VISION_CLASSIFIER_FALLBACK_MODEL=
MEAL_PLANNER_FALLBACK_MODEL=
COACH_FALLBACK_MODEL=
INSIGHT_NARRATOR_FALLBACK_MODEL=
#
# Example: local-first with cloud fallback
# LOCAL_AI_API_BASE=http://host.docker.internal:11434
# FOOD_EXTRACTOR_MODEL=local/gemma-4-e4b-it
# FOOD_EXTRACTOR_FALLBACK_MODEL=gemini/gemini-2.5-flash

# Whisper STT
WHISPER_URL=http://whisper:9000
# Model size vs. accuracy trade-off (English-only variants are ~50% smaller):
#   tiny.en | base.en | small.en | medium.en | large-v3
# base.en is baked into the Docker image — any other model downloads once on first start.
WHISPER_MODEL=base.en

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,https://health.yourdomain.com
VITE_USE_MOCK_DATA=1

# Port bindings for the frontend nginx container.
# Standalone mode (default): leave unset — binds 80 and 443 on the host.
# Behind-proxy mode: set these to avoid conflicting with the outer proxy.
#   LUMA_HTTP_PORT=8080   — outer proxy connects here
#   LUMA_HTTPS_PORT=8443  — avoids conflict with outer proxy on 443 (unused internally)
#LUMA_HTTP_PORT=8080
#LUMA_HTTPS_PORT=8443
