# Luma — Environment Variables
# Copy to .env and fill in real values before running.

# Database
PG_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql+asyncpg://sh:${PG_PASSWORD}@postgres:5432/luma

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=changeme_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# HAE Webhook
HAE_SHARED_SECRET=changeme_generate_with_openssl_rand_hex_32

# LLM
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=

# Remote Local AI Server (Ollama / LocalAI / Llama.cpp)
# Set to your remote local AI endpoint (e.g. http://host.docker.internal:11434 to reference your host machine's Ollama from Docker)
LOCAL_AI_API_BASE=http://host.docker.internal:11434
LOCAL_AI_API_KEY=

# LLM Model Routing
# Use local/<id> to force local OpenAI-compatible routing via LOCAL_AI_API_BASE.
# Use provider/<id> for direct cloud routing via LiteLLM provider adapters.
FOOD_EXTRACTOR_MODEL=local/gemma-4-e4b-it
VISION_CLASSIFIER_MODEL=local/gemma-4-e4b-it
MEAL_PLANNER_MODEL=anthropic/claude-sonnet-4-5
COACH_MODEL=gemini/gemini-2.5-flash
INSIGHT_NARRATOR_MODEL=anthropic/claude-sonnet-4-5

# Whisper
WHISPER_URL=http://whisper:9000

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,https://health.yourdomain.com
VITE_USE_MOCK_DATA=1
