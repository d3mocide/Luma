# ─────────────────────────────────────────────────────────────────────────────
# Luma — environment configuration
# Copy to .env, fill in secrets, then: docker compose up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployment mode ───────────────────────────────────────────────────────────

# LUMA_PROXY_MODE=false (default)
#   Luma's nginx terminates TLS directly. A self-signed cert is generated on
#   first start and stored in the nginx_certs Docker volume. To use a real cert,
#   copy fullchain.pem + privkey.pem into that volume before starting.
#
# LUMA_PROXY_MODE=true
#   Luma's nginx serves plain HTTP. TLS is handled by your upstream proxy.
#   Set LUMA_HTTP_PORT to a port your proxy can reach (e.g. 8080) so it doesn't
#   conflict with the proxy's own 80/443. LUMA_HTTPS_PORT just needs to be a
#   free port — nothing listens on it inside the container in this mode.
#
# Your upstream proxy_pass block:
#   proxy_pass http://127.0.0.1:8080;
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#   proxy_set_header Host              $host;

LUMA_PROXY_MODE=false
LUMA_DOMAIN=localhost
LUMA_HTTP_PORT=80
LUMA_HTTPS_PORT=443

# ── Database ──────────────────────────────────────────────────────────────────

PG_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql+asyncpg://sh:${PG_PASSWORD}@postgres:5432/luma

# ── Cache ─────────────────────────────────────────────────────────────────────

REDIS_URL=redis://redis:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────

JWT_SECRET=changeme_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── HAE webhook ───────────────────────────────────────────────────────────────

HAE_SHARED_SECRET=changeme_generate_with_openssl_rand_hex_32

# ── LLM cloud keys ────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=

# ── USDA FoodData Central ─────────────────────────────────────────────────────
# Free API key: https://fdc.nal.usda.gov/api-key-signup
# Used by /foods/search as a live fallback when the local food cache is sparse.
# Leave blank to search local DB only.
USDA_API_KEY=

# ── LLM model routing ─────────────────────────────────────────────────────────
# LiteLLM is used as a library — no separate proxy container.
# Each role is routed independently; mix local and cloud freely.
#
# Prefix rules:
#   local/<model-id>     → OpenAI-compatible request to LOCAL_AI_API_BASE
#   gemini/<model-id>    → Google Gemini via GEMINI_API_KEY
#   anthropic/<model-id> → Anthropic API via ANTHROPIC_API_KEY
#
# If a fallback model is set and the primary call fails, LiteLLM retries with
# the fallback automatically. Leave blank to disable fallback for that role.
#
# Example — local primary with cloud fallback:
#   LOCAL_AI_API_BASE=http://host.docker.internal:11434
#   FOOD_EXTRACTOR_MODEL=local/gemma-4-e4b-it
#   FOOD_EXTRACTOR_FALLBACK_MODEL=gemini/gemini-3.5-flash

LOCAL_AI_API_BASE=
LOCAL_AI_API_KEY=

FOOD_EXTRACTOR_MODEL=gemini/gemini-3.5-flash
FOOD_EXTRACTOR_FALLBACK_MODEL=anthropic/claude-haiku-4-5

VISION_CLASSIFIER_MODEL=gemini/gemini-3.5-flash
VISION_CLASSIFIER_FALLBACK_MODEL=anthropic/claude-haiku-4-5

MEAL_PLANNER_MODEL=anthropic/claude-sonnet-4-5
MEAL_PLANNER_FALLBACK_MODEL=gemini/gemini-3.5-flash

COACH_MODEL=gemini/gemini-3.5-flash
COACH_FALLBACK_MODEL=anthropic/claude-haiku-4-5

INSIGHT_NARRATOR_MODEL=gemini/gemini-3.5-flash
INSIGHT_NARRATOR_FALLBACK_MODEL=anthropic/claude-haiku-4-5

RECIPE_IMPORT_MODEL=gemini/gemini-3.5-flash
RECIPE_IMPORT_FALLBACK_MODEL=anthropic/claude-haiku-4-5

# ── Whisper STT ───────────────────────────────────────────────────────────────
# Model size vs. accuracy (English-only variants are ~50% smaller):
#   tiny.en | base.en | small.en | medium.en | large-v3
# base.en is baked into the Docker image; any other model downloads on first
# start and is cached in the whisper_model_cache volume.

WHISPER_URL=http://whisper:9000
WHISPER_MODEL=base.en

# ── Family sharing — SMTP for invitation emails (optional) ───────────────────
# Leave SMTP_HOST blank to disable email sending entirely. Invitation tokens still
# work — the API response includes the token so the inviter can share the link manually.
#
# APP_BASE_URL is used to build the accept link embedded in invitation emails.
# Set it to the public URL of your Luma instance (no trailing slash).
APP_BASE_URL=http://localhost:5173

# ── Option A: Basic Auth SMTP (Mailgun, Postmark, Gmail, etc.) ────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true

# ── Option B: OAuth 2.0 / SASL XOAUTH2 (works with M365, Google Workspace, etc.) ────
# Set SMTP_OAUTH_TOKEN_URL to use OAuth instead of Basic Auth.
# Leave SMTP_USER and SMTP_PASSWORD blank — OAuth does not use them.
#
# Microsoft 365 (Entra ID):
#   1. Register an app in Entra ID, add the SMTP.SendMail *application* permission,
#      and grant admin consent.
#   2. Enable SMTP AUTH on the mailbox (Exchange admin):
#        Set-CASMailbox -Identity <SMTP_FROM> -SmtpClientAuthenticationDisabled $false
#   SMTP_HOST=smtp.office365.com
#   SMTP_OAUTH_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
#   SMTP_OAUTH_SCOPE=https://outlook.office365.com/.default
#
# Google Workspace:
#   1. Create a service account, enable domain-wide delegation, and grant the
#      https://mail.google.com/ scope in the Admin console.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
#   SMTP_OAUTH_SCOPE=https://mail.google.com/
SMTP_OAUTH_TOKEN_URL=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_SCOPE=

# ── Push Notifications (optional) ────────────────────────────────────────────
# Generate VAPID key pair:  make gen-vapid  (requires containers to be running)
# Copy the printed private key and public key (applicationServerKey) below.
# Leave blank to disable push notifications entirely.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=admin@example.com

# ── App ───────────────────────────────────────────────────────────────────────

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,https://localhost

# IANA timezone name used to define calendar-day boundaries for the /today
# endpoint, streaks, and goal recommendations. Set this to the timezone where
# most users are located so "today" aligns with their local clock rather than
# the server's UTC clock. Common values: America/New_York, America/Chicago,
# America/Denver, America/Los_Angeles, Europe/London, Asia/Tokyo.
SERVER_TIMEZONE=UTC
VITE_USE_MOCK_DATA=0

# ── Dev Hot Reloading (for container mounts on Windows/Mac) ──────────────────
CHOKIDAR_USEPOLLING=1
CHOKIDAR_INTERVAL=200